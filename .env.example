# ── LLM Provider ──────────────────────────────────────────────────────────────
# Options: "openai" | "local"
LLM_PROVIDER=openai

# ── OpenAI API ─────────────────────────────────────────────────────────────────
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...your-key-here...
OPENAI_MODEL=gpt-4o-mini

# ── Local GGUF Model (llama-cpp-python) ────────────────────────────────────────
# Download a GGUF model, e.g.:
#   Mistral-7B-Instruct: https://huggingface.co/TheBloke/Mistral-7B-Instruct-v0.2-GGUF
#   Llama-3-8B-Instruct: https://huggingface.co/QuantFactory/Meta-Llama-3-8B-Instruct-GGUF
# Place the .gguf file in the models/llm/ folder and set the path below.
LOCAL_MODEL_PATH=models/llm/mistral-7b-instruct-v0.2.Q4_K_M.gguf
